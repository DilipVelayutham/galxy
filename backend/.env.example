MONGO_URI=mongodb://localhost:27017/galxy
DB_NAME=galxy

# AI Provider
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Rate Limits
AI_FREE_GENERATIONS_PER_SESSION=5
AI_MAX_GENERATIONS_PER_USER_PER_DAY=20
AI_GENERATION_TIMEOUT_SECONDS=30

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Flask
FLASK_ENV=development
SECRET_KEY=changeme_supersecret_key_here
JWT_SECRET=changeme_jwt_secret_here

# Module URLs (for cross-module validation calls)
MODULE4_VALIDATE_URL=http://localhost:5004/api/internal/validate-attributes
