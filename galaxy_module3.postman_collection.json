    {
      "name": "Admin Routes",
      "item": [
        {
          "name": "Get Admin Products List",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/products?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "stock_status",
                  "value": "made_to_order",
                  "disabled": true
                },
                {
                  "key": "is_active",
                  "value": "true",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Product",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"6686b245e4b06825c5d082f4\",\n  \"title\": \"Nova Glow Neon Sign\",\n  \"type\": \"pre_designed\",\n  \"base_price\": 1299.0,\n  \"description\": \"Charming cosmic-themed neon name board for bedrooms.\",\n  \"specifications\": {\n    \"material\": \"Flex LED & Clear Acrylic\",\n    \"power\": \"12V Adapter Included\",\n    \"avg_production_days\": 5\n  },\n  \"default_attributes\": {\n    \"font\": \"cursive\",\n    \"color\": \"pink\",\n    \"backing\": \"clear\"\n  },\n  \"stock_status\": \"made_to_order\",\n  \"tags\": [\n    \"new\",\n    \"cosmic\"\n  ],\n  \"is_featured\": false,\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "products"
              ]
            },
            "description": "Note: Replace category_id with a valid, active category ID from your seeded database."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data._id) {",
                  "    pm.collectionVariables.set('productId', jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Product",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Nova Glow Neon Sign Updated\",\n  \"base_price\": 1399.0,\n  \"stock_status\": \"in_stock\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
